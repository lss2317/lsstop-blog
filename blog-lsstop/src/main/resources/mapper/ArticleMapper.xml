<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lsstop.mapper.ArticleMapper">

    <resultMap id="archiveVoResult" type="com.lsstop.domain.vo.ArticleArchiveVO">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="articleTitle" column="article_title" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <resultMap id="articleListVoResult" type="com.lsstop.domain.vo.ArticleListVO">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="articleCover" column="article_cover" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="articleTitle" column="article_title" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="categoryId" column="category_id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="categoryName" column="category_name" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <collection property="tags" ofType="com.lsstop.domain.vo.TagSimpleVO">
            <id property="id" column="tag_id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
            <result property="tagName" column="tag_name" jdbcType="VARCHAR" javaType="java.lang.String"/>
        </collection>
    </resultMap>

    <select id="getArchiveList" resultMap="archiveVoResult">
        select id,
               article_title,
               create_time
        from blog_article
        where deleted_at = 0
          and status = 1
        order by create_time desc
    </select>

    <select id="getArticleListByCategory" resultMap="articleListVoResult">
        select a.id,
               a.article_cover,
               a.article_title,
               a.category_id,
               c.category_name,
               a.create_time,
               t.id as tag_id,
               t.tag_name
        from blog_article a
                 left join blog_category c on a.category_id = c.id
                 left join blog_article_tag bat on a.id = bat.article_id
                 left join blog_tag t on bat.tag_id = t.id
        where a.deleted_at = 0
          and a.status = 1
          and a.category_id = #{categoryId}
        order by a.create_time desc
    </select>

    <select id="getArticleListByTag" resultMap="articleListVoResult">
        select a.id,
               a.article_cover,
               a.article_title,
               a.category_id,
               c.category_name,
               a.create_time,
               t.id as tag_id,
               t.tag_name
        from blog_article a
                 left join blog_category c on a.category_id = c.id
                 left join blog_article_tag bat on a.id = bat.article_id
                 left join blog_tag t on bat.tag_id = t.id
        where a.deleted_at = 0
          and a.status = 1
          and a.id in (select article_id from blog_article_tag where tag_id = #{tagId})
        order by a.create_time desc
    </select>

</mapper>
