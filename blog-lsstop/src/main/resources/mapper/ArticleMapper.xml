<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lsstop.mapper.ArticleMapper">

    <resultMap id="articleHomeVoResult" type="com.lsstop.domain.vo.ArticleHomeVO">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="articleCover" column="article_cover" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="articleTitle" column="article_title" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="articleContent" column="article_content" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="categoryId" column="category_id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="categoryName" column="category_name" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="isTop" column="is_top" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <collection property="tags" ofType="com.lsstop.domain.vo.TagSimpleVO">
            <id property="id" column="tag_id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
            <result property="tagName" column="tag_name" jdbcType="VARCHAR" javaType="java.lang.String"/>
        </collection>
    </resultMap>

    <resultMap id="archiveVoResult" type="com.lsstop.domain.vo.ArticleArchiveVO">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="articleTitle" column="article_title" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <resultMap id="articleListVoResult" type="com.lsstop.domain.vo.ArticleListVO">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="articleCover" column="article_cover" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="articleTitle" column="article_title" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="categoryId" column="category_id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="categoryName" column="category_name" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <collection property="tags" ofType="com.lsstop.domain.vo.TagSimpleVO">
            <id property="id" column="tag_id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
            <result property="tagName" column="tag_name" jdbcType="VARCHAR" javaType="java.lang.String"/>
        </collection>
    </resultMap>

    <select id="getArchiveList" resultMap="archiveVoResult">
        select id,
               article_title,
               create_time
        from blog_article
        where deleted_at = 0
          and status = 1
        order by create_time desc
    </select>

    <select id="getArticleListByCategory" resultMap="articleListVoResult">
        select a.id,
               a.article_cover,
               a.article_title,
               a.category_id,
               c.category_name,
               a.create_time,
               t.id as tag_id,
               t.tag_name
        from blog_article a
                 left join blog_category c on a.category_id = c.id
                 left join blog_article_tag bat on a.id = bat.article_id and bat.deleted_at = 0
                 left join blog_tag t on bat.tag_id = t.id and t.deleted_at = 0
        where a.deleted_at = 0
          and a.status = 1
          and a.category_id = #{categoryId}
        order by a.create_time desc
    </select>

    <select id="getArticleListByTag" resultMap="articleListVoResult">
        select a.id,
               a.article_cover,
               a.article_title,
               a.category_id,
               c.category_name,
               a.create_time,
               t.id as tag_id,
               t.tag_name
        from blog_article a
                 left join blog_category c on a.category_id = c.id
                 left join blog_article_tag bat on a.id = bat.article_id and bat.deleted_at = 0
                 left join blog_tag t on bat.tag_id = t.id and t.deleted_at = 0
        where a.deleted_at = 0
          and a.status = 1
          and a.id in (select article_id from blog_article_tag where tag_id = #{tagId} and deleted_at = 0)
        order by a.create_time desc
    </select>

    <select id="getHomeArticleList" resultMap="articleHomeVoResult">
        select a.id,
               a.article_cover,
               a.article_title,
               a.article_content,
               a.category_id,
               c.category_name,
               a.is_top,
               a.create_time,
               t.id as tag_id,
               t.tag_name
        from blog_article a
                 left join blog_category c on a.category_id = c.id
                 left join blog_article_tag bat on a.id = bat.article_id and bat.deleted_at = 0
                 left join blog_tag t on bat.tag_id = t.id and t.deleted_at = 0
        where a.deleted_at = 0
          and a.status = 1
        order by a.is_top desc, a.create_time desc
        limit #{offset}, #{pageSize}
    </select>

    <select id="getArticleCount" resultType="java.lang.Integer">
        select count(*)
        from blog_article
        where deleted_at = 0
          and status = 1
    </select>

    <resultMap id="articleVoResult" type="com.lsstop.domain.vo.ArticleVO">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="articleCover" column="article_cover" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="articleTitle" column="article_title" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="articleContent" column="article_content" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="categoryId" column="category_id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="categoryName" column="category_name" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <collection property="tags" ofType="com.lsstop.domain.vo.TagSimpleVO">
            <id property="id" column="tag_id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
            <result property="tagName" column="tag_name" jdbcType="VARCHAR" javaType="java.lang.String"/>
        </collection>
    </resultMap>

    <resultMap id="articleSimpleVoResult" type="com.lsstop.domain.vo.ArticleSimpleVO">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="articleCover" column="article_cover" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="articleTitle" column="article_title" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <select id="getArticleById" resultMap="articleVoResult">
        select a.id,
               a.article_cover,
               a.article_title,
               a.article_content,
               a.category_id,
               c.category_name,
               a.create_time,
               a.update_time,
               t.id as tag_id,
               t.tag_name
        from blog_article a
                 left join blog_category c on a.category_id = c.id
                 left join blog_article_tag bat on a.id = bat.article_id and bat.deleted_at = 0
                 left join blog_tag t on bat.tag_id = t.id and t.deleted_at = 0
        where a.id = #{id}
          and a.deleted_at = 0
          and a.status = 1
    </select>

    <select id="getPreArticle" resultMap="articleSimpleVoResult">
        select id,
               article_cover,
               article_title,
               create_time
        from blog_article
        where deleted_at = 0
          and status = 1
          and create_time <![CDATA[<]]> #{createTime}
        order by create_time desc
        limit 1
    </select>

    <select id="getNextArticle" resultMap="articleSimpleVoResult">
        select id,
               article_cover,
               article_title,
               create_time
        from blog_article
        where deleted_at = 0
          and status = 1
          and create_time <![CDATA[>]]> #{createTime}
        order by create_time
        limit 1
    </select>

    <select id="getNewestArticles" resultMap="articleSimpleVoResult">
        select id,
               article_cover,
               article_title,
               create_time
        from blog_article
        where deleted_at = 0
          and status = 1
        order by create_time desc
        limit #{limit}
    </select>

    <select id="getRecommendArticles" resultMap="articleSimpleVoResult">
        select id,
               article_cover,
               article_title,
               create_time
        from blog_article
        where deleted_at = 0
          and status = 1
          and category_id = #{categoryId}
          and id != #{excludeId}
        order by create_time desc
        limit #{limit}
    </select>

    <select id="getHotArticles" resultMap="articleSimpleVoResult">
        select id,
               article_cover,
               article_title,
               create_time
        from blog_article
        where deleted_at = 0
          and status = 1
          <if test="excludeIds != null and excludeIds.size() > 0">
              and id not in
              <foreach collection="excludeIds" item="id" open="(" separator="," close=")">
                  #{id}
              </foreach>
          </if>
        order by view_count desc
        limit #{limit}
    </select>

    <select id="listAllArticleViewCounts" resultType="com.lsstop.domain.vo.ArticleViewCountVO">
        select id, view_count as viewCount
        from blog_article
        where deleted_at = 0
    </select>

    <update id="batchUpdateViewCounts">
        update blog_article
        set view_count = case id
        <foreach collection="list" item="item">
            when #{item.id} then #{item.viewCount}
        </foreach>
        end
        where id in
        <foreach collection="list" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>

    <select id="selectTitleById" resultType="java.lang.String">
        select article_title
        from blog_article
        where id = #{id}
          and deleted_at = 0
    </select>

</mapper>
