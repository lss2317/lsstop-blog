<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lsstop.mapper.TalkMapper">

    <resultMap id="talkResultMap" type="com.lsstop.domain.entity.Talk">
        <id column="id" property="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="user_id" property="userId" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="content" property="content" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result column="is_top" property="isTop" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="status" property="status" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="is_delete" property="isDelete" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <resultMap id="talkVoResultMap" type="com.lsstop.domain.vo.TalkVo">
        <id column="id" property="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="avatar" property="avatar" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result column="nickname" property="nickname" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result column="content" property="content" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result column="is_top" property="isTop" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <collection property="imgList" ofType="java.lang.String">
            <result column="image_url" jdbcType="VARCHAR" javaType="java.lang.String"/>
        </collection>
    </resultMap>

    <resultMap id="talkStatsResultMap" type="com.lsstop.domain.dto.TalkStatsDto">
        <id column="id" property="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="likeCount" property="likeCount" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="commentCount" property="commentCount" jdbcType="INTEGER" javaType="java.lang.Integer"/>
    </resultMap>

    <select id="listTalk" resultMap="talkVoResultMap">
        select bt.id,
               bup.avatar,
               bup.nickname,
               bt.content,
               bt.is_top,
               bt.create_time,
               bti.image_url
        from blog_talk bt
                 left join blog_user_profile bup on bt.user_id = bup.user_id and bup.is_delete = 0
                 left join blog_talk_image bti on bt.id = bti.talk_id and bti.is_delete = 0
        where bt.is_delete = 0
          and bt.status = 1
        order by bt.is_top desc, bt.create_time desc, bti.sort
    </select>

    <select id="getTalkById" resultMap="talkVoResultMap">
        select bt.id,
               bup.avatar,
               bup.nickname,
               bt.content,
               bt.is_top,
               bt.create_time,
               bti.image_url
        from blog_talk bt
                 left join blog_user_profile bup on bt.user_id = bup.user_id and bup.is_delete = 0
                 left join blog_talk_image bti on bt.id = bti.talk_id and bti.is_delete = 0
        where bt.is_delete = 0
          and bt.status = 1
          and bt.id = #{id}
        order by bti.sort
    </select>

    <!-- 统计所有说说的点赞数和评论数 -->
    <select id="countTalkStats" resultMap="talkStatsResultMap">
        select t.id,
               coalesce(l.like_count, 0)    as likeCount,
               coalesce(c.comment_count, 0) as commentCount
        from blog_talk t
                 left join (select target_id, count(*) as like_count
                            from blog_like_record
                            where type = 1
                              and status = 1
                            group by target_id) l on t.id = l.target_id
                 left join (select target_id, count(*) as comment_count
                            from blog_comment
                            where target_type = 3
                              and is_delete = 0
                              and status = 1
                            group by target_id) c on t.id = c.target_id
        where t.is_delete = 0
    </select>

</mapper>