<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lsstop.mapper.CommentMapper">

    <resultMap id="commentCountResultMap" type="com.lsstop.domain.dataObject.CommentCountDO">
        <result column="target_id" property="targetId" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result column="comment_count" property="commentCount" jdbcType="INTEGER" javaType="java.lang.Integer"/>
    </resultMap>

    <!-- 按目标类型统计各目标的评论数 -->
    <select id="countCommentsByTargetType" resultMap="commentCountResultMap">
        select target_id, count(*) as comment_count
        from blog_comment
        where target_type = #{targetType}
          and is_delete = 0
          and status = 1
        group by target_id
    </select>

</mapper>
