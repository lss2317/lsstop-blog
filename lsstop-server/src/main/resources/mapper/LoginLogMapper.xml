<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lsstop.mapper.LoginLogMapper">

    <!-- 登录日志ResultMap -->
    <resultMap id="LoginLogResultMap" type="com.lsstop.domain.entity.LoginLogEntity">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="userId" column="user_id" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="loginType" column="login_type" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="loginTime" column="login_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <result property="ipAddress" column="ip_address" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="ipRegion" column="ip_region" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="browser" column="browser" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="os" column="os" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="type" column="type" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="state" column="state" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="loginIdentifier" column="login_identifier" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="message" column="message" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="deletedAt" column="deleted_at" jdbcType="BIGINT" javaType="java.lang.Long"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <!-- 插入登录日志 -->
    <insert id="insert" parameterType="com.lsstop.domain.entity.LoginLogEntity">
        INSERT INTO blog_login_log (user_id, login_type, login_time, ip_address, ip_region,
                                    browser, os, type, state, login_identifier, message, deleted_at, create_time, update_time)
        VALUES (#{userId}, #{loginType}, #{loginTime}, #{ipAddress}, #{ipRegion},
                #{browser}, #{os}, #{type}, #{state}, #{loginIdentifier}, #{message}, 0, NOW(), NOW())
    </insert>

    <!-- 查询用户最近一次成功登录的 IP 归属地 -->
    <select id="selectLatestIpRegionByUserId" resultType="java.lang.String">
        SELECT ip_region
        FROM blog_login_log
        WHERE user_id = #{userId}
          AND state = 0
          AND deleted_at = 0
        ORDER BY login_time DESC
        LIMIT 1
    </select>

</mapper>
