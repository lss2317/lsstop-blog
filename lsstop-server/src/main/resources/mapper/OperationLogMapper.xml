<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lsstop.mapper.OperationLogMapper">

    <!-- 操作日志ResultMap -->
    <resultMap id="OperationLogResultMap" type="com.lsstop.domain.entity.OperationLogEntity">
        <id property="id" column="id" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="logNumber" column="log_number" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="userId" column="user_id" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="module" column="module" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="operationType" column="operation_type" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="description" column="description" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="requestUrl" column="request_url" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="requestParam" column="request_param" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="responseParam" column="response_param" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="ipAddress" column="ip_address" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="ipRegion" column="ip_region" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="browser" column="browser" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="os" column="os" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="costTime" column="cost_time" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="state" column="state" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="errorMsg" column="error_msg" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="deletedAt" column="deleted_at" jdbcType="BIGINT" javaType="java.lang.Long"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
    </resultMap>

    <!-- 插入操作日志 -->
    <insert id="insert" parameterType="com.lsstop.domain.entity.OperationLogEntity">
        INSERT INTO blog_operation_log (log_number, user_id, module, operation_type, description, request_url, request_param,
                                        response_param, ip_address, ip_region, browser, os, cost_time, state, error_msg,
                                        deleted_at, create_time, update_time)
        VALUES (#{logNumber}, #{userId}, #{module}, #{operationType}, #{description}, #{requestUrl}, #{requestParam},
                #{responseParam}, #{ipAddress}, #{ipRegion}, #{browser}, #{os}, #{costTime}, #{state}, #{errorMsg},
                0, NOW(), NOW())
    </insert>

    <!-- 操作日志列表ResultMap -->
    <resultMap id="OperationLogVOResultMap" type="com.lsstop.domain.vo.OperationLogVO">
        <result property="logNumber" column="log_number" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="module" column="module" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="operationType" column="operation_type" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="description" column="description" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="requestUrl" column="request_url" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="userId" column="user_id" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="nickname" column="nickname" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="ipAddress" column="ip_address" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="ipRegion" column="ip_region" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="browser" column="browser" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="os" column="os" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="state" column="state" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="costTime" column="cost_time" jdbcType="INTEGER" javaType="java.lang.Integer"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP" javaType="java.time.LocalDateTime"/>
        <result property="requestParam" column="request_param" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="responseParam" column="response_param" jdbcType="VARCHAR" javaType="java.lang.String"/>
        <result property="errorMsg" column="error_msg" jdbcType="VARCHAR" javaType="java.lang.String"/>
    </resultMap>

    <!-- 分页查询操作日志列表 -->
    <select id="selectList" resultMap="OperationLogVOResultMap">
        select ol.log_number,
               ol.module,
               ol.operation_type,
               ol.description,
               ol.request_url,
               ol.user_id,
               up.nickname,
               ol.ip_address,
               ol.ip_region,
               ol.browser,
               ol.os,
               ol.state,
               ol.cost_time,
               ol.create_time,
               ol.request_param,
               ol.response_param,
               ol.error_msg
        from blog_operation_log ol
                 left join blog_user_profile up on ol.user_id = up.user_id and up.deleted_at = 0
        where ol.deleted_at = 0
        <if test="module != null and module != ''">
            and ol.module like concat('%', #{module}, '%')
        </if>
        <if test="operationType != null and operationType != ''">
            and ol.operation_type = #{operationType}
        </if>
        <if test="userId != null and userId != ''">
            and ol.user_id = #{userId}
        </if>
        order by ol.create_time desc
        limit #{offset}, #{size}
    </select>

    <!-- 统计操作日志总数 -->
    <select id="countTotal" resultType="java.lang.Integer">
        select count(*)
        from blog_operation_log
        where deleted_at = 0
        <if test="module != null and module != ''">
            and module like concat('%', #{module}, '%')
        </if>
        <if test="operationType != null and operationType != ''">
            and operation_type = #{operationType}
        </if>
        <if test="userId != null and userId != ''">
            and user_id = #{userId}
        </if>
    </select>

</mapper>
